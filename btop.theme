# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000409"

# Main text color
theme[main_fg]="#d2e8f6"

# Title color for boxes
theme[title]="#d2e8f6"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#00cca7"

# Background color of selected item in processes box. #101318 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1d22 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1d22"

# Foreground color of selected item in processes box. Use #d2e8f6 so
# the row text stays readable on the lighter_bg highlight; the previous
# #00cca7 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#d2e8f6"

# Color of inactive/disabled text
theme[inactive_fg]="#76cbde"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #d9ebf7 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #d2e8f6 directly.
theme[graph_text]="#d2e8f6"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #101318 collapsed to the main fg.
theme[meter_bg]="#1a1d22"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #00b3c1 for a distinct accent instead of #d9ebf7 which capped to white.
theme[proc_misc]="#00b3c1"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#8e1b59"
theme[mem_box]="#00cca7"
theme[net_box]="#ba456e"
theme[proc_box]="#00cca7"

# Box divider line and small boxes line color
theme[div_line]="#76cbde"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#00cca7"
theme[temp_mid]="#c39d18"
theme[temp_end]="#ba456e"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#00b3c1"
theme[cpu_mid]="#328bd6"
theme[cpu_end]="#8e1b59"

# Mem/Disk free meter
theme[free_start]="#8e1b59"
theme[free_mid]="#328bd6"
theme[free_end]="#00b3c1"

# Mem/Disk cached meter
theme[cached_start]="#328bd6"
theme[cached_mid]="#00b3c1"
theme[cached_end]="#8e1b59"

# Mem/Disk available meter
theme[available_start]="#c39d18"
theme[available_mid]="#ba456e"
theme[available_end]="#ba456e"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#00cca7"
theme[used_mid]="#00b3c1"
theme[used_end]="#328bd6"

# Download graph colors
theme[download_start]="#c39d18"
theme[download_mid]="#ba456e"
theme[download_end]="#ba456e"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#00cca7"
theme[upload_mid]="#00b3c1"
theme[upload_end]="#328bd6"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#00b3c1"
theme[process_mid]="#328bd6"
theme[process_end]="#8e1b59"
